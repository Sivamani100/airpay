# Android SDK & Build Environment Configuration
# Copy this file to .env or set variables in your shell environment.
# All values below are placeholder examples. NEVER commit real passwords or keystores.

# Android SDK Path
# ANDROID_HOME=C:\Users\username\AppData\Local\Android\Sdk

# Java 17+ JDK Path
# JAVA_HOME=C:\Program Files\Android\Android Studio\jbr

# Release Signing Configuration (Optional - for release builds only)
# KEYSTORE_FILE=release.keystore
# KEYSTORE_PASSWORD=placeholder_keystore_password
# KEY_ALIAS=placeholder_key_alias
# KEY_PASSWORD=placeholder_key_password
